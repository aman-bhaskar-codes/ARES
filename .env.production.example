# ARES production template. Do not commit real values. A reverse proxy/TLS terminator
# should expose PUBLIC_BASE_URL and forward to the API container on the private network.
DEPLOYMENT_ENVIRONMENT=production
ARES_MODE=local_live
AUTH_MODE=oidc
STRICT_FREE_MODE=true
ALLOW_BILLABLE_PROVIDERS=false
PUBLIC_BASE_URL=https://ares.example.com
FRONTEND_ORIGIN=https://ares.example.com
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Concrete LOGIN roles must be provisioned separately and granted membership in ares_api/ares_worker.
DATABASE_URL=postgresql+psycopg://ares_api_login:CHANGE_ME@postgres:5432/ares
WORKER_DATABASE_URL=postgresql+psycopg://ares_worker_login:CHANGE_ME@postgres:5432/ares
# Used only by migration/role-provisioning jobs, never by the public API/worker process.
MIGRATION_DATABASE_URL=postgresql+psycopg://ares_admin:CHANGE_ME@postgres:5432/ares
BLOB_ROOT=/app/data/blobs

OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

SEARXNG_URL=http://searxng:8080
MAX_HTTP_CONCURRENCY=4
SOURCE_FETCH_TIMEOUT_SECONDS=12
PROVIDER_HTTP_TIMEOUT_SECONDS=20

# M10 faster/stronger live research. Caches are workspace-scoped; semantic checking is optional.
DISCOVERY_CONCURRENCY=3
RESEARCH_CACHE_ENABLED=true
WEB_SEARCH_CACHE_TTL_SECONDS=3600
WEB_SOURCE_CACHE_TTL_SECONDS=21600
ACADEMIC_CACHE_TTL_SECONDS=604800
SOFTWARE_CACHE_TTL_SECONDS=3600
ACADEMIC_FULL_TEXT_ENABLED=true
ACADEMIC_FULL_TEXT_LIMIT=2
ACADEMIC_FULL_TEXT_TIMEOUT_SECONDS=20
ACADEMIC_FULL_TEXT_MAX_BYTES=20971520
ACADEMIC_FULL_TEXT_MAX_PAGES=100
SEMANTIC_CHECKER_ENABLED=false
SEMANTIC_CHECKER_MODEL=gemini-3.8-flash
SEMANTIC_CHECKER_MAX_CLAIMS=6
SEMANTIC_CHECKER_TIMEOUT_SECONDS=30
BROWSER_ENABLED=false
BROWSER_SERVICE_URL=http://browser:8090
BROWSER_SERVICE_TOKEN=replace-with-random-32-plus-character-token
BROWSER_TIMEOUT_SECONDS=20
MAX_ACTIVE_RUNS=8
MAX_ACTIVE_RUNS_PER_WORKSPACE=3
MAX_ACTIVE_RUNS_PER_USER=2
MAX_JOB_ATTEMPTS=3
MAX_REQUEST_BODY_BYTES=26214400
READINESS_REQUIRES_WORKER=true
REQUIRED_SCHEMA_REVISION=0013

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_CONCURRENCY=1
GEMINI_TIMEOUT_SECONDS=45
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=

GEMINI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_RPM=
GEMINI_EMBEDDING_TPM=
GEMINI_EMBEDDING_RPD=
MAX_EMBED_CHUNKS_PER_RUN=240

OPENALEX_API_KEY=
CROSSREF_MAILTO=
ARXIV_MIN_INTERVAL_SECONDS=3
GITHUB_READ_TOKEN=
JEV_ENABLED=false
JEV_API_KEY=

JSON_LOGS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ares
OTEL_TRACE_SAMPLE_RATIO=0.10
OTEL_EXPORT_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_SECONDS=10
WORKER_STALE_SECONDS=45
WORKER_HEALTH_FILE=/app/data/worker-health

# M09 media is opt-in. Provision the runtime-media image + pinned model before enabling.
AUDIO_ENABLED=false
VIDEO_ENABLED=false
CLOUD_MEDIA_ENABLED=false
MICROPHONE_ENABLED=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_ASSET_REQUEST_BODY_BYTES=110100480
MAX_AUDIO_BYTES=52428800
MAX_AUDIO_DURATION_SECONDS=600
MAX_VIDEO_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_SOURCE_PIXELS=12000000
MAX_VIDEO_FRAMES=60
VIDEO_BASELINE_FRAMES=31
VIDEO_SCENE_THRESHOLD=0.35
VIDEO_FRAME_OCR_LIMIT=8
WHISPER_MODEL_PATH=/app/.data/models/whisper-small-ct2
WHISPER_MODEL_REVISION=REPLACE_WITH_EXACT_MODEL_REVISION
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=5
WHISPER_TIMEOUT_SECONDS=360

# Durable SSE replay and bounded authorization revalidation.
EVENT_PAGE_SIZE=100
EVENT_MAX_REPLAY=1000
EVENT_HEARTBEAT_SECONDS=15
STREAM_AUTHORIZATION_RECHECK_SECONDS=10
# M08 durable assets, rich parsing and local indexing. Heavy media/ML work belongs on the media worker profile.
ASYNC_INGESTION_ENABLED=true
RICH_PARSER_ENABLED=false
OCR_ENABLED=false
LOCAL_EMBEDDINGS_ENABLED=false
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_DIMENSIONS=384
LOCAL_EMBEDDING_CACHE_DIR=.data/models/fastembed
LOCAL_EMBEDDING_THREADS=2
LOCAL_EMBEDDING_BATCH_SIZE=32
MAX_BACKGROUND_EMBED_CHUNKS=4000
DOCLING_TIMEOUT_SECONDS=120
DOCLING_MODEL_CACHE_DIR=.data/models/docling
OCR_LANGUAGE=iso:en
MAX_RICH_PDF_PAGES=100
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_CSV_ROWS=5000
MAX_TABLE_CELLS=50000
MAX_CELL_CHARS=10000
WORKER_PROFILE=research


# M11 evidence-linked visual research workspace. Generated artifacts are validated
# server-side and remain bounded to authorized run evidence.
VISUALIZATIONS_ENABLED=true
VISUALIZATION_GRAPH_MAX_NODES=100
VISUALIZATION_GRAPH_MAX_EDGES=200
